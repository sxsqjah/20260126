[Unit]
Description=Crypto-K Quants Website
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/Ckqpro-GW
Environment=NODE_ENV=production
ExecStart=/root/.nvm/versions/node/v24.18.0/bin/node /root/Ckqpro-GW/node_modules/vite/bin/vite.js preview --host 0.0.0.0 --port 5175 --strictPort
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
